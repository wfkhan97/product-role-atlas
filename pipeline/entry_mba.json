 "title": {
  "note": "Words in a title, for any employer. 'not_for_them' and 'phd' stop every rule: a job about students is not a job for them, and a posting for PhD graduates only is not marked. 'pre' and 'mba' name the audience outright ('pre' not with a 'campus_not' word, 'mba' not with 'mba_not'). A posting on a 'no_mark_levels' level gets a mark only from a firm row or from these two. 'summer_associate' is the MBA internship at banks and most firms (a firm row says otherwise for L.E.K.). 'campus' words, an internship or a programme (the ldp role) show a student or new-graduate posting whose audience the title does not name: it is read as pre_mba after the text and the category have had their say, unless the title has a 'campus_not' word.",
  "intern": "\\bintern(ship)?s?\\b|\\bco-?op\\b|\\bsummer\\s+(associate|analyst|consultant|fellow|program(me)?)s?\\b",
  "not_for_them": "\\brecruit(er|ers|ment)\\b|\\b(recruiting|talent\\s+acquisition|admissions|early\\s+careers?|campus|university\\s+relations)\\s+(manager|lead|leader|director|coordinator|specialist|partner|advisor|program\\s+manager)\\b|\\b(manager|lead|leader|director|head|coordinator|specialist|partner|advisor|vice\\s+president|vp),?\\s+(of\\s+)?(\\w+\\s+){0,2}(recruit\\w*|talent\\s+acquisition|early\\s+careers?|campus|university)\\b|\\bprogram\\s+manager\\b|\\bprograms?\\s+(leader|advisor|manager|lead|director|specialist|coordinator)\\b|\\blearning\\s*(&|and)\\s*development\\b|\\bL&D\\b|\\btalent\\s+acquisition\\b",
  "phd": "\\bph\\.?d\\b|\\bABD\\b|\\bpost-?doc",
  "mba_not": "\\bMBA\\s+(preferred|a\\s+plus|desired|or\\s+equivalent)\\b",
  "pre": "\\b(pre|non)[- ]?MBA\\b|\\bundergrad(uate)?s?\\b|\\bbachelor'?s?\\b|\\bsummer\\s+analyst\\b",
  "mba": "\\bMBA\\b",
  "summer_associate": "\\bsummer\\s+(associate|consultant)\\b",
  "campus": "\\bnew\\s+grad(uate)?s?\\b|\\bentry[- ]level\\b|\\bclass\\s+of\\s+20\\d\\d\\b|(?<![A-Za-z0-9_])20(2[6-9])(?![A-Za-z0-9_])|\\bearly\\s+(career|talent)s?\\b|\\buniversity\\s+(grad(uate)?s?|associate|analyst|hire|program)\\b|^\\W*campus\\b|\\bcampus\\s+(20\\d\\d|recruiting|hire|graduate|program)\\b|\\b(recent|college)\\s+(college\\s+)?grad(uate)?s?\\b|\\bgraduate\\s+(program(me)?|rotational|scheme|analyst|associate|trainee|leadership)\\b|\\bgraduate\\W*$|\\brotational\\b|\\banalyst\\s+program(me)?\\b|\\btrainee\\b",
  "campus_not": "\\b(senior|sr\\.?|director|vice\\s+president|vp|principal|head|store|branch)\\b|\\bexperienced\\s+(professional|hire)s?\\b",
  "no_mark_levels": [
   "staff",
   "group",
   "director",
   "vp",
   "cpo"
  ]
 },
 "text": {
  "note": "Words in the cleaned posting text. 'student' lines say who the posting is written for (a degree in progress, a graduation year) and are trusted before the category default. A student line that names an MBA ('mba') marks the posting mba, unless the line has an 'mba_not' word (then the line is skipped: most MBA mentions are \"MBA preferred\") or also names a bachelor's degree ('undergrad': then pre_mba). A student line with no MBA marks it pre_mba. 'weak' lines (no experience asked) are read after the category default, only on 'weak_levels' and only when the title has no 'weak_not' word.",
  "student": "\\b(pursuing|enrolled\\s+in|completing|working\\s+towards?)\\s+(an?\\s+|your\\s+|their\\s+|the\\s+)?((undergraduate|graduate|bachelor'?s?|master'?s?|MBA|BA|BS|B\\.[AS]\\.?|MS|four[- ]year|4[- ]year|college|university|full[- ]time|part[- ]time|advanced|accredited|business|[a-z]+)\\W+){0,4}?(degree|MBA|bachelor'?s|master'?s|(under)?graduate\\s+program)|\\b(expected\\s+)?(to\\s+)?graduat(e|es|ing|ion)(\\s+date)?\\b[^.\\n]{0,70}(?<![A-Za-z0-9_])20(2[6-9])(?![A-Za-z0-9_])|\\b(first|1st|second|2nd|final|last|penultimate)[- ]year\\b[^.\\n]{0,30}\\b(MBA|business\\s+school|students?|undergraduates?)\\b|\\brising\\s+(junior|senior|sophomore)s?\\b|\\bcurrent(ly)?\\s+(an?\\s+)?(college\\s+|university\\s+|undergraduate\\s+|graduate\\s+|MBA\\s+|full[- ]time\\s+)?students?\\b|\\b(college|university)\\s+(junior|senior|sophomore)s?\\b|\\bMBA\\s+(student|candidate|intern)s?\\b",
  "mba": "\\bM\\.?B\\.?A\\b|\\bmaster'?s?\\s+(degree\\s+)?(of|in)\\s+business\\s+administration\\b|\\bbusiness\\s+school\\b",
  "mba_not": "\\bprefer|\\ba\\s+plus\\b|\\bdesir|\\basset\\b|\\bnot\\s+required\\b|\\bpost[- ]?MBA\\b|\\bnice\\s+to\\s+have\\b|\\b(non|pre)[- ]?MBA\\b|\\bor\\s+(a\\s+)?(CPA|CFA)\\b|\\b(earned|possess\\w*|obtained|completed|have)\\s+or\\b|\\bmay\\s+include\\b|\\bencouraged\\b|\\bworking\\s+towards?\\s+obtaining\\b",
  "weak": "\\b0\\s*(-|–|to)\\s*[12]\\s*\\+?\\s*years?\\b|\\bminimum\\s+years\\s+of\\s+experience:\\s*0\\b|\\bno\\s+(prior\\s+|previous\\s+)?(work\\s+)?experience\\s+(is\\s+)?(required|necessary|needed)\\b|\\b(recent|new)\\s+(college\\s+|university\\s+)?graduates?\\b|\\bentry[- ]level\\s+(position|role|opportunity)\\b",
  "weak_not": "\\b(senior|sr\\.?|experienced|manager|lead|director|principal|ii+|[2-9])\\b",
  "student_levels": [
   "associate",
   "mid",
   "senior"
  ],
  "weak_levels": [
   "associate",
   "mid"
  ],
  "undergrad": "\\bbachelor|\\bundergraduate|\\bB\\.?[AS]\\b\\.?"
 }
}
