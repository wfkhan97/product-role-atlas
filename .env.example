# Copy to .env (gitignored) and fill in what you need. pipeline/env.py reads it; values already set in the
# environment win. The values live in the owner's password manager (the Macs) and in each repository's GitHub
# Actions secrets (the scheduled jobs): nowhere else, never in a commit, a doc, a log or a chat.

# The session-pooler connection string of the Supabase project that holds the raw postings backlog and the runs
# table. Needs: pipeline.backlog (push, pull, verify, status), pipeline.scrape (pushes each file as it writes it),
# pipeline.store bootstrap (the backlog part), the runs row pipeline/log.py writes when a stage ends, pipeline.runs.
SUPABASE_DB_URL=

# The project's URL. Needs: pipeline.backlog snapshot, pipeline.store (any command). Default when unset: the
# backlog project (pipeline/backlog.py, DEFAULT_URL).
SUPABASE_URL=

# The project's service-role key (Settings > API keys). Needs: pipeline.backlog snapshot (the `backlog` bucket),
# pipeline.store push, pull, status, bootstrap (the `atlas-store` bucket).
SUPABASE_SERVICE_ROLE_KEY=

# The session-pooler connection string of the gradbuddy-catalog project (the `waitlist` and `events` tables of the
# capture, v16). Needs: pipeline.funnel; it falls back to SUPABASE_DB_URL, which points at the backlog project.
CAPTURE_DB_URL=

# OpenRouter key. Needs: pipeline.depth_gen and pipeline.build_steps live runs (--dry-run needs none).
OPENROUTER_API_KEY=

# OpenAI key. Needs: pipeline.experiments.skill_audit and pipeline.experiments.decisions_audit live runs
# (--dry-run and --reuse need none).
OPENAI_API_KEY=

# Optional. The file every stage also logs to (run_all.sh sets logs/run_<date>.log); nothing when unset.
PIPELINE_LOG=

# Optional. INFO when unset; DEBUG shows more. Read by pipeline/log.py in every stage.
PIPELINE_LOG_LEVEL=
